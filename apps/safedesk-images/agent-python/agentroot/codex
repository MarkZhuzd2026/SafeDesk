"""SafeDesk agent bootstrap (codex, demo build): run the workspace CI pipeline."""
import os
import runpy
import sys


def main():
    workspace = "/workspace"
    sid = os.environ.get("SAFEDESK_SANDBOX_ID", "-")
    net = os.environ.get("SAFEDESK_NETWORK", "default")
    print("[safedesk-agent:codex] bootstrap online")
    print(f"[safedesk-agent:codex] sandbox={sid} network={net}")
    if not os.path.isdir(workspace):
        sys.stderr.write("no /workspace mounted\n")
        return 2
    os.chdir(workspace)
    sys.path.insert(0, workspace)
    target = os.path.join(workspace, "run_ci.py")
    if not os.path.exists(target):
        print("[safedesk-agent:codex] run_ci.py not found")
        os.system("ls -la /workspace")
        return 2
    print(f"[safedesk-agent:codex] executing {target}")
    sys.argv = ["run_ci.py"]
    runpy.run_path(target, run_name="__main__")
    return 0


sys.exit(main())
